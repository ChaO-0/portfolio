---
import Transition from "../components/Transition.astro";
import { site } from "../data/site";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** og:type. "profile" only on the page that is about the person. */
  ogType?: "website" | "profile" | "article";
  /** Keep the page out of the index. The 404 is a real URL that should never rank. */
  noindex?: boolean;
}

const { title, description, ogType = "website", noindex = false } = Astro.props;

// The Person is one entity, so it gets described once. Emitting it on every page
// with that page's description attached said nine different things about the same
// person; emitting it only where the page is actually about him says one.
const isPersonPage = ogType === "profile";

// og:image and canonical both require absolute URLs. Astro.site comes from
// astro.config.mjs, so these follow the domain automatically.
const canonical = new URL(Astro.url.pathname, Astro.site);
// Bump when the image changes. Scrapers key on the whole URL, and X and LinkedIn
// hold a card for about a week, so without this a new image is invisible on every
// link already shared. The file itself stays at /og.png.
const OG_VERSION = 2;
const ogImage = new URL(`/og.png?v=${OG_VERSION}`, Astro.site);

// Person schema is what makes a search for his name resolve to him rather than to
// a namesake, and it's what feeds a knowledge panel. No offers, no ratings: the
// page publishes no prices and he has no client reviews, and markup that claims
// either would describe a page that doesn't exist.
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  jobTitle: site.role,
  description: site.bio,
  url: new URL("/about/", Astro.site).href,
  image: ogImage.href,
  email: `mailto:${site.email}`,
  address: {
    "@type": "PostalAddress",
    addressLocality: site.location.split(",")[0],
    addressCountry: "ID",
  },
  sameAs: [site.github, site.linkedin, site.x],
  knowsAbout: [
    "TypeScript",
    "Next.js",
    "Node.js",
    "PostgreSQL",
    "Prisma",
    "SaaS development",
    "Internal tools",
    "System architecture",
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#0B1013" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} · ${site.role}`} />

    {/* attributes the card to his account when the link is pasted on X, which is
        where most of these links get shared */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@christopheryuu_" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300..600&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    {/* Anything JS fades in starts at opacity 0, which without JS is content that
        never arrives — on the home page that is the whole pitch and both calls to
        action. Crawlers that do not run JS see the same empty hero. */}
    <noscript>
      <style>
        [data-hero-fade],
        [data-hero-panel],
        [data-fade] {
          opacity: 1 !important;
        }
      </style>
    </noscript>

    {isPersonPage && <script type="application/ld+json" set:html={JSON.stringify(person)} is:inline />}

    {/* Vercel Web Analytics. Vercel's edge serves this path, so it 404s anywhere
        else — including `astro dev`, hence the PROD gate keeping the dev console
        clean. Needs Analytics switched on in the project's Vercel dashboard. */}
    {import.meta.env.PROD && <script is:inline defer src="/_vercel/insights/script.js" />}
  </head>
  <body>
    <Transition />
    <slot />
  </body>
</html>
