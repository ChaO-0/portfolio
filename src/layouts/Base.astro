---
import { embedded, pricing, site } from "../data/site";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// og:image and canonical both require absolute URLs. Astro.site comes from
// astro.config.mjs, so these follow the domain automatically.
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.png", Astro.site);

// Publishing prices is the unusual part of this business, and prices are exactly
// the kind of thing worth making machine-readable: not for a rich snippet, Google
// promises none for a Person, but so search engines and the assistants people now
// ask for recommendations can answer "what does he charge" without guessing.
//
// minPrice, not price, because every fixed tier is advertised "from". Claiming a
// flat price for a range would be a lie in a machine-readable field, which is the
// worst place to keep one. Embedded is a real flat monthly rate, so it uses price.
//
// Nothing here carries a rating, a review or an aggregate: he has no clients yet,
// and inventing that markup is both a manual-action risk and false.
const priceNumber = (v: string) => Number(v.replace(/[^0-9.]/g, ""));

const offers = [
  ...pricing.map((tier) => ({
    "@type": "Offer",
    name: tier.label,
    description: tier.body,
    priceSpecification: {
      "@type": "PriceSpecification",
      minPrice: priceNumber(tier.price),
      priceCurrency: "USD",
    },
  })),
  {
    "@type": "Offer",
    name: embedded.label,
    description: embedded.body,
    priceSpecification: {
      "@type": "UnitPriceSpecification",
      price: priceNumber(embedded.price),
      priceCurrency: "USD",
      unitCode: "MON", // UN/CEFACT code for month
    },
  },
];

// Person schema is what makes a search for his name resolve to him rather than to
// a namesake, and it's what feeds a knowledge panel.
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  jobTitle: site.role,
  description,
  url: canonical.href,
  image: ogImage.href,
  email: `mailto:${site.email}`,
  address: {
    "@type": "PostalAddress",
    addressLocality: site.location.split(",")[0],
    addressCountry: "ID",
  },
  sameAs: [site.github, site.linkedin, site.x],
  knowsAbout: [
    "TypeScript",
    "Next.js",
    "NestJS",
    "Node.js",
    "PostgreSQL",
    "SaaS development",
    "Internal tools",
    "Payments and reconciliation",
  ],
  makesOffer: offers,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#0a0e18" />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} · ${site.role}`} />

    {/* attributes the card to his account when the link is pasted on X, which is
        where most of these links get shared */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@christopheryuu_" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400..700;1,400..700&family=Space+Grotesk:wght@300..700&family=Geist+Mono:wght@300..600&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(person)} is:inline />

    {/* Vercel Web Analytics. Vercel's edge serves this path, so it 404s anywhere
        else — including `astro dev`, hence the PROD gate keeping the dev console
        clean. Needs Analytics switched on in the project's Vercel dashboard. */}
    {import.meta.env.PROD && <script is:inline defer src="/_vercel/insights/script.js" />}
  </head>
  <body>
    <slot />
  </body>
</html>
