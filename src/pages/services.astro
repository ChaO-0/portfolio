---
import Process from "../components/Process.astro";
import { priceList, rescue, services, site } from "../data/site";
import Cta from "../components/Cta.astro";
import Doc from "../layouts/Doc.astro";

const toc = [
  ...services.map((s, i) => ({ id: s.id, label: `${String(i + 1).padStart(2, "0")}  ${s.nav}` })),
  { id: rescue.id, label: "RESCUE & TAKEOVER" },
  { id: "how", label: "HOW IT WORKS" },
  { id: "pricing", label: "PRICING" },
];

const projects = priceList.filter((p) => !p.ongoing);
const ongoing = priceList.filter((p) => p.ongoing);

// What you are agreeing to, separate from what it costs. This was a page of its
// own until the only thing on it that /services did not already say was this table.
const terms = [
  {
    k: "FIXED PRICE",
    v: "Agreed in writing before anything starts. Changes go on a list rather than into the current build, and get priced separately.",
  },
  {
    k: "INVOICING",
    v: "Projects invoice against milestones rather than up front. Monthly work invoices at the start of each month.",
  },
  {
    k: "OWNERSHIP",
    v: "Your repos and your hosting from the first commit, so nothing is ever hostage to the relationship continuing.",
  },
  {
    k: "MINIMUM",
    v: "One month on ongoing work, with two weeks' notice to stop. Projects have no minimum beyond their own starting price.",
  },
  {
    k: "NO HOURLY",
    v: "You are buying an outcome, not my time. There is no timesheet to argue about.",
  },
];

const meta = [
  { k: "BASED", v: "Bali · UTC+8" },
  { k: "CLIENTS", v: "Remote" },
  { k: "OVERLAP", v: "Europe & APAC" },
  { k: "STATUS", v: "Available now", accent: true },
];
---

<Doc
  title={`Services · ${site.name}`}
  description="Three things I build: products from idea to production, internal tools that replace spreadsheets, and product websites. Senior engineering without agency overhead."
  label="SERVICES"
  back={{ href: "/", label: site.name.toUpperCase() }}
  meta={meta}
  tocTitle="Services"
  toc={toc}
  tocSplit={services.length}
>
  <Fragment slot="headline">
    <div class="eyebrow mb-[26px]">WHAT I CAN BUILD FOR YOU</div>
    <h1
      class="max-w-[860px] text-[clamp(42px,5.8vw,80px)] leading-[0.97] font-medium tracking-[-0.04em]"
    >
      <span class="line"><span data-line class="block">One engineer,</span></span>
      <span class="line"
        ><span data-line class="block">whole <span class="text-mint">system</span>.</span></span
      >
    </h1>
    <p class="mt-[30px] max-w-[620px] text-[18.5px] leading-[1.6] text-mute">
      Three things I do, and what each one actually involves. Senior engineering without the
      overhead of an agency: you work directly with the person writing the code, and the
      price reflects that there is nobody else to pay.
    </p>
    <p class="mono mt-5 max-w-[620px] border-l border-line pl-4 text-[11px] leading-[1.9] text-dim">
      Best suited for founders and small teams who have a clear problem to solve and want a senior
      engineer to own the implementation.
    </p>
  </Fragment>

  {
    services.map((s, i) => (
      <section
        id={s.id}
        class:list={["scroll-mt-[90px]", i > 0 && "mt-[62px] border-t border-line pt-[52px]"]}
      >
        <div class="flex flex-wrap items-baseline gap-3.5">
          <span class="mono text-xs text-mint">{String(i + 1).padStart(2, "0")}</span>
          <h2 data-reveal class="text-[38px] leading-[1.08] font-medium tracking-[-0.03em]">
            {s.title}
          </h2>
          <span
            data-reveal
            class="mono ml-auto text-xs tracking-[0.06em] whitespace-nowrap text-mint"
          >
            {s.price}
            <span class="text-[10px] tracking-[0.1em] text-dim">&nbsp;· {s.unit}</span>
          </span>
        </div>

        <p data-reveal class="mt-2.5 max-w-[680px] text-[19px] leading-[1.5] text-paper">
          {s.tagline}
        </p>
        <p data-reveal class="mt-[18px] max-w-[680px] text-lg leading-[1.65] text-mute">{s.body}</p>

        <div data-reveal class="hairgrid mt-[26px] sm:grid-cols-2">
          <div class="px-5 py-[18px]">
            <div class="mono mb-2.5 text-[10px] text-mint">YOU GET</div>
            <div class="text-[15.5px] leading-[1.75] text-mute">{s.youGet}</div>
          </div>
          <div class="px-5 py-[18px]">
            <div class="mono mb-2.5 text-[10px] text-mint">WHAT I NEED FROM YOU</div>
            <div class="text-[15.5px] leading-[1.75] text-mute">{s.need}</div>
          </div>
        </div>

        {s.note && (
          <div
            data-reveal
            class="mt-3.5 border-l-2 border-mint bg-mint/5 py-3 pl-4 text-[16px] leading-[1.6] text-paper"
          >
            {s.note}
          </div>
        )}
      </section>
    ))
  }

  {/* Compact by design: no rescue in the portfolio yet, so it does not get a card
      the size of the three that are proven. */}
  <section
    id={rescue.id}
    class="mt-[62px] scroll-mt-[90px] border-t border-line pt-[52px]"
  >
    <div class="flex flex-wrap items-baseline gap-3.5">
      <span class="mono text-[10px] text-dim">ALSO</span>
      <h2 data-reveal class="text-[26px] leading-[1.15] font-medium tracking-[-0.02em]">
        {rescue.title}
      </h2>
      <span data-reveal class="mono ml-auto text-[11px] tracking-[0.06em] whitespace-nowrap text-mint">
        {rescue.price}
        <span class="text-[10px] tracking-[0.1em] text-dim">&nbsp;· {rescue.unit}</span>
      </span>
    </div>
    <p data-reveal class="mt-3.5 max-w-[680px] text-[16.5px] leading-[1.6] text-mute">
      {rescue.body}
    </p>
  </section>

  {/* Deliberately small and last: the offers above are what this page sells, and
      rates belong in a conversation, not in competition with them. */}
  <section id="how" class="mt-[70px] scroll-mt-[90px] border-t border-line pt-[52px]">
    <div class="eyebrow mb-5">HOW IT WORKS</div>
    <h2 data-reveal class="text-[34px] leading-[1.12] font-medium tracking-[-0.025em]">
      How an idea becomes a production system.
    </h2>
    <p data-reveal class="mt-[22px] mb-9 max-w-[680px] text-lg leading-[1.65] text-mute">
      Five steps, in this order, on every project. Ongoing capacity for agencies and teams runs
      differently and <a href="/for-agencies" class="text-mint">has its own page</a>.
    </p>
    <Process />
  </section>

  <section id="pricing" class="mt-[70px] scroll-mt-[90px] border-t border-line pt-[52px]">
    <div class="eyebrow mb-5">PRICING</div>
    <h2 data-reveal class="text-[34px] leading-[1.12] font-medium tracking-[-0.025em]">
      What it costs, before you ask.
    </h2>
    <p data-reveal class="mt-[22px] max-w-[680px] text-lg leading-[1.65] text-mute">
      Every figure is a floor, not a ceiling. What a project actually costs depends on how much of
      it there is, and you get that number in writing after a call and before anyone commits to
      anything.
    </p>

    <div data-reveal class="rows mt-7 [--rows-label:1fr] [--rows-body:auto]">
      {
        projects.map((p) => (
          <a href={p.href} class="group">
            <div class="px-5 py-[18px]">
              <div class="text-[19px] tracking-[-0.01em] transition-colors group-hover:text-mint">
                {p.label}
              </div>
              <div class="mono mt-1 text-[10px] text-dim">{p.unit.toUpperCase()}</div>
            </div>
            <div class="mono flex items-center justify-end px-5 py-[18px] text-lg text-mint">
              {p.price}
            </div>
          </a>
        ))
      }
    </div>

    <div class="mono mt-9 mb-3 text-[10px] tracking-[0.12em] text-dim">ONGOING</div>
    <div data-reveal class="rows [--rows-label:1fr] [--rows-body:auto]">
      {
        ongoing.map((p) => (
          <a href={p.href} class="group">
            <div class="px-5 py-[18px]">
              <div class="text-[19px] tracking-[-0.01em] transition-colors group-hover:text-mint">
                {p.label}
              </div>
              <div class="mono mt-1 text-[10px] text-dim">{p.unit.toUpperCase()}</div>
            </div>
            <div class="mono flex items-center justify-end px-5 py-[18px] text-lg text-mint">
              {p.price}
            </div>
          </a>
        ))
      }
    </div>

    <h3 data-reveal class="mt-11 mb-6 text-[22px] tracking-[-0.02em]">What you are agreeing to.</h3>
    <div data-reveal class="rows [--rows-label:190px]">
      {
        terms.map((t) => (
          <div>
            <div class="mono px-5 py-[18px] text-[10.5px] text-mint">{t.k}</div>
            <div class="px-5 py-[18px] text-[15.5px] leading-[1.6] text-mute">{t.v}</div>
          </div>
        ))
      }
    </div>

    <p data-reveal class="mt-[22px] max-w-[680px] text-lg leading-[1.65] text-mute">
      These are lower than an agency would quote for the same work, and the reason is
      structural rather than a discount: there is one person on the invoice, and no office, sales
      team or account layer to carry.
    </p>
  </section>

  <Cta heading="Tell me what you are building." />
</Doc>
