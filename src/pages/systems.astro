---
import { site } from "../data/site";
import Cta from "../components/Cta.astro";
import Doc from "../layouts/Doc.astro";

const toc = [
  { id: "spine", label: "01  THE SPINE" },
  { id: "state", label: "02  WHERE STATE LIVES" },
  { id: "growth", label: "03  WHEN TO ADD" },
  { id: "failure", label: "04  FAILURE CASES" },
  { id: "three", label: "05  THREE PRODUCTS" },
  { id: "refuse", label: "06  WHAT I REFUSE" },
];

const meta = [
  { k: "SCOPE", v: "3 products" },
  { k: "SHAPE", v: "Same spine" },
  { k: "STORE", v: "Postgres" },
  { k: "RULE", v: "Add nothing early" },
];

// One entry per row of the diagram, so a row that holds two boxes side by side is
// just a row with two nodes. Dashed means the part is added only when a
// measurement calls for it, never up front.
const spine = [
  [{ n: "01", name: "CLIENT", note: "typed end to end", lit: true }],
  [{ n: "02", name: "API", note: "one surface, validated" }],
  [{ n: "03", name: "POSTGRES", note: "the only truth", lit: true }],
  [
    { n: "04", name: "CACHE", note: "later", dashed: true },
    { n: "05", name: "WORKERS" },
  ],
  [{ n: "06", name: "EDGES", note: "wrapped, fallible" }],
];

const state = [
  [
    "FACTS",
    "Rows a human created or a payment provider confirmed. Written once, corrected by a new row rather than an overwrite where it matters.",
  ],
  [
    "DERIVED",
    "Totals, pacing, availability, progress. Recomputed on write where reads are frequent, always rebuildable from facts alone.",
  ],
  ["EPHEMERAL", "Filters, open panels, form drafts. Lives in the client and is allowed to be lost."],
  [
    "NOWHERE ELSE",
    "No business rule in a component. No total that only exists in a chart. No truth in a cache.",
  ],
];

const triggers = [
  [
    "A CACHE",
    "When a query is slow, frequent, and provably the bottleneck. It must be invalidatable by hand, and the app must be correct without it.",
  ],
  [
    "A QUEUE",
    "When work is slow enough to time out a request, or must survive a restart. PDFs, email, imports. Never for speed alone.",
  ],
  [
    "A SECOND SERVICE",
    "When two parts of the product genuinely scale or deploy differently. Almost never true in year one.",
  ],
  ["AN ABSTRACTION", "On the third occurrence, not the second. Two similar things are a coincidence."],
];

const failures = [
  ["Email provider", "Nothing, it is not in their path", "Queued, retried, alerted after N failures"],
  [
    "Payment provider",
    "A plain message, not a stack trace",
    "Nothing marked paid without a confirmed webhook",
  ],
  ["File storage", "Upload disabled, rest of app works", "No half-written records pointing at nothing"],
  ["The database", "An honest status page", "Point-in-time backups, restore actually tested"],
];

const hardParts = [
  {
    title: "Monark",
    kind: "FINANCE",
    body: "The hard part was arithmetic you cannot get slightly wrong. Money as integers in minor units, pacing recomputed on write so the dashboard is one indexed read, and two currencies reading from the same column.",
    tags: ["DERIVED ROLLUPS", "INTEGER MONEY", "MULTI-CURRENCY"],
    href: "/work/monark",
  },
  {
    title: "ClassPortal",
    kind: "TENANCY",
    body: "The hard part was tenancy, not scheduling. The same records have to serve a tutor working alone and a tutor inside an agency, so every resolver answers the organisation question before it answers anything else, and reassigning a student between tutors has to carry their sessions, assignments and invoices with them.",
    tags: ["THREE-ROLE TENANCY", "MATERIALISED RECURRENCE", "ONE GRAPHQL SURFACE", "EN / ID"],
    href: "/work/classportal",
  },
  {
    title: "Stencil",
    kind: "BOOKING",
    body: "The hard part was that an enquiry and a booking are not the same object. An enquiry is quoted, then accepted or declined. A booking then has a life of its own through deposit, confirmation and completion, and can still be cancelled or no-showed. Collapsing both into one status column would have made every question about money ambiguous.",
    tags: ["TWO STATE MACHINES", "35 RLS POLICIES", "OWNER / ARTIST ROLES", "EN / ID"],
    href: "/work/stencil",
  },
];

const refusals = [
  [
    "Ship without backups I have restored from.",
    "An untested backup is a belief, not a backup.",
  ],
  [
    "Mark money as received without a confirmed webhook.",
    "Optimistic payment state is how you end up refunding strangers.",
  ],
  ["Put a business rule only in the interface.", "If it matters, the database enforces it too."],
  [
    "Hand over a system nobody but me can run.",
    "If the docs do not let your next engineer deploy it, the job is not finished.",
  ],
];
---

<Doc
  title={`Systems · ${site.name}`}
  description="How I think about architecture: the same six-part spine on every product, where state lives, when complexity is worth adding, and the failure cases decided before launch."
  label="SYSTEMS"
  back={{ href: "/", label: site.name.toUpperCase() }}
  meta={meta}
  tocTitle="Contents"
  toc={toc}
>
  <Fragment slot="headline">
    <div class="eyebrow mb-[26px]">HOW I THINK ABOUT ARCHITECTURE</div>
    <h1
      class="max-w-[860px] text-[clamp(42px,5.8vw,80px)] leading-[0.97] font-medium tracking-[-0.04em]"
    >
      <span class="line"><span data-line class="block">Boring architecture,</span></span>
      <span class="line"
        ><span data-line class="block">chosen <span class="text-mint">on purpose</span>.</span
        ></span
      >
    </h1>
    <p class="mt-[30px] max-w-[620px] text-[18.5px] leading-[1.6] text-mute">
      Most products do not fail because the framework was wrong. They fail because state ended up in
      three places, because nobody decided what happens when the payment provider is down, or
      because someone added a queue in month two and a cache in month three and now nothing is
      debuggable.
    </p>
  </Fragment>

  <section id="spine" class="scroll-mt-[90px]">
    <div class="eyebrow mb-5">01&nbsp;&nbsp;THE SPINE</div>
    <h2 data-reveal class="text-[34px] leading-[1.12] font-medium tracking-[-0.025em]">
      Every product I build has the same six parts.
    </h2>
    <p data-reveal class="mt-[22px] text-lg leading-[1.65] text-mute">
      Not because I am incurious, but because the shape is not where the value is. A typed client,
      one API surface, a relational database holding the truth, a cache only where reads got
      expensive, workers for anything slow, and third-party services kept at the edges. What changes
      between products is the domain model, and that is where the thinking should go.
    </p>

    <div data-reveal class="mt-8 border border-line bg-panel px-[26px] py-7">
      <div class="mono mb-6 text-[9.5px] tracking-[0.12em] text-dim">FIG. 01 / THE SPINE</div>

      <div class="mono flex max-w-[420px] flex-col text-[10.5px] tracking-[0.07em]">
        {
          spine.map((row, i) => (
            <>
              <div class="flex gap-2">
                {row.map((node) => (
                  <div
                    class:list={[
                      "flex flex-1 justify-between gap-3 px-[15px] py-[13px]",
                      node.dashed && "border border-dashed border-edge text-mute",
                      node.lit && "border border-mint bg-mint/10 text-mint",
                      !node.dashed && !node.lit && "border border-mint/45",
                    ]}
                  >
                    <span>
                      {node.n} {node.name}
                    </span>
                    {node.note && <span class="text-mute">{node.note}</span>}
                  </div>
                ))}
              </div>

              {i < spine.length - 1 && (
                <div class="relative ml-6 h-[30px] w-px overflow-hidden bg-mint/30">
                  <span
                    class="absolute top-0 left-0 h-3.5 w-px bg-mint"
                    style={`animation:pkt 1.8s linear ${i * 0.35}s infinite`}
                  />
                </div>
              )}
            </>
          ))
        }
      </div>

      <div class="mono mt-[22px] border-t border-line pt-4 text-[10px] leading-[1.9] text-mute">
        DASHED = ADDED ONLY WHEN MEASURED, NOT WHEN IMAGINED
      </div>
    </div>
  </section>

  <section id="state" class="mt-[72px] scroll-mt-[90px]">
    <div class="eyebrow mb-5">02&nbsp;&nbsp;WHERE STATE LIVES</div>
    <h2 data-reveal class="text-[34px] leading-[1.12] font-medium tracking-[-0.025em]">
      One place, and everything else derives from it.
    </h2>
    <p data-reveal class="mt-[22px] text-lg leading-[1.65] text-mute">
      The first question on any project is which facts are true and where they are written down.
      Everything after that is derivation. If a number can be computed from the facts, it gets
      computed, or it gets stored in something explicitly labelled as derived and rebuildable with
      one command.
    </p>

    <div data-reveal class="rows mt-7 [--rows-label:160px]">
      {
        state.map(([k, v], i) => (
          <div>
            <div
              class:list={[
                "mono px-[18px] py-[15px] text-[10.5px]",
                i === state.length - 1 ? "text-mute" : "text-mint",
              ]}
            >
              {k}
            </div>
            <div class="px-[18px] py-[15px] text-[15.5px] leading-[1.55] text-mute">{v}</div>
          </div>
        ))
      }
    </div>
  </section>

  <section id="growth" class="mt-[72px] scroll-mt-[90px]">
    <div class="eyebrow mb-5">03&nbsp;&nbsp;WHEN TO ADD</div>
    <h2 data-reveal class="text-[34px] leading-[1.12] font-medium tracking-[-0.025em]">
      Complexity has to be earned by a measurement.
    </h2>
    <p data-reveal class="mt-[22px] text-lg leading-[1.65] text-mute">
      Every extra component is a thing that can fail at 2am, and a thing the next engineer has to
      understand. So each one needs a trigger, agreed in advance, rather than a hunch.
    </p>

    <div data-reveal class="hairgrid mt-7 sm:grid-cols-2">
      {
        triggers.map(([k, v]) => (
          <div class="px-5 pt-5 pb-[22px]">
            <div class="mono mb-2 text-[10px] text-mint">{k}</div>
            <div class="text-[15.5px] leading-[1.55] text-mute">{v}</div>
          </div>
        ))
      }
    </div>
  </section>

  <section id="failure" class="mt-[72px] scroll-mt-[90px]">
    <div class="eyebrow mb-5">04&nbsp;&nbsp;FAILURE CASES</div>
    <h2 data-reveal class="text-[34px] leading-[1.12] font-medium tracking-[-0.025em]">
      Decided before launch, not during the incident.
    </h2>
    <p data-reveal class="mt-[22px] text-lg leading-[1.65] text-mute">
      Every third party in the system gets the same three questions written down: what does the user
      see when it is down, what happens to the work that was in flight, and how do I know it
      happened without a customer telling me.
    </p>

    <div data-reveal class="mt-7 overflow-x-auto">
      <table class="w-full min-w-[620px] border-collapse border border-line text-left">
        <thead class="mono bg-panel text-[9.5px] tracking-[0.12em] text-mute">
          <tr>
            <th class="border-b border-line px-4 py-3 font-normal">WHEN THIS IS DOWN</th>
            <th class="border-b border-l border-line px-4 py-3 font-normal">THE USER SEES</th>
            <th class="border-b border-l border-line px-4 py-3 font-normal">THE WORK</th>
          </tr>
        </thead>
        <tbody class="text-[15px] leading-[1.5]">
          {
            failures.map(([who, sees, work], i) => (
              <tr class:list={[i < failures.length - 1 && "border-b border-line"]}>
                <td class="px-4 py-3.5 text-paper">{who}</td>
                <td class="border-l border-line px-4 py-3.5 text-mute">{sees}</td>
                <td class="border-l border-line px-4 py-3.5 text-mute">{work}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section id="three" class="mt-[72px] scroll-mt-[90px]">
    <div class="eyebrow mb-5">05&nbsp;&nbsp;THREE PRODUCTS, ONE SPINE</div>
    <h2 data-reveal class="text-[34px] leading-[1.12] font-medium tracking-[-0.025em]">
      Same shape, different hard parts.
    </h2>
    <p data-reveal class="mt-[22px] text-lg leading-[1.65] text-mute">
      The architecture barely changes between my three products. The domain problem changes
      completely, and that is where the weeks go.
    </p>

    {
      hardParts.map((p, i) => (
        <div
          data-reveal
          class:list={[
            "grid gap-6 border-t border-line py-6 sm:grid-cols-[150px_1fr]",
            i === 0 && "mt-[30px]",
            i === hardParts.length - 1 && "border-b",
          ]}
        >
          <div>
            <div class="text-[22px] tracking-[-0.02em]">{p.title}</div>
            <div class="mono mt-1.5 text-[9.5px] text-mute">{p.kind}</div>
          </div>
          <div>
            <div class="mb-3.5 text-[16.5px] leading-[1.6] text-mute">{p.body}</div>
            <div class="mono flex flex-wrap gap-2 text-[10px] tracking-[0.08em] text-mint">
              {p.tags.map((t) => (
                <span class="border border-mint/40 px-[9px] py-[5px]">{t}</span>
              ))}
            </div>
            {p.href ? (
              <a href={p.href} class="navlink mono mt-4 inline-block text-[10.5px] text-mint">
                READ THE CASE STUDY →
              </a>
            ) : (
              <span class="mono mt-4 inline-block text-[10.5px] text-mute">CASE STUDY, NEXT</span>
            )}
          </div>
        </div>
      ))
    }
  </section>

  <section id="refuse" class="mt-[72px] scroll-mt-[90px]">
    <div class="eyebrow mb-5">06&nbsp;&nbsp;WHAT I REFUSE TO DO</div>
    <h2 data-reveal class="text-[34px] leading-[1.12] font-medium tracking-[-0.025em]">
      Four things, regardless of who asks.
    </h2>

    <div data-reveal class="mt-[26px] flex flex-col">
      {
        refusals.map(([rule, why], i) => (
          <div
            class:list={[
              "grid grid-cols-[34px_1fr] gap-4 border-t border-line py-5",
              i === refusals.length - 1 && "border-b",
            ]}
          >
            <span class="mono text-[10.5px] text-mint">{String(i + 1).padStart(2, "0")}</span>
            <div class="text-[16.5px] leading-[1.6] text-mute">
              <span class="text-paper">{rule}</span> {why}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <Cta heading="Want this decided properly on your product?" layout="inline" />
</Doc>
