---
import Mark from "../components/Mark.astro";
import { nav, site } from "../data/site";
import Base from "../layouts/Base.astro";

// The map is derived from the nav, so a route added later shows up here as one
// more thing that does resolve, and the count below it stays honest.
const routes = [{ label: "Home", href: "/" }, ...nav];
const year = new Date().getFullYear();
---

<Base
  title={`Page not found · ${site.name}`}
  description="That route does not resolve. Everything else on the site does."
  noindex
>
  <div class="flex min-h-screen flex-col">
    <header
      class="mono flex items-center justify-between gap-4 border-b border-line px-5 py-[15px] text-[10.5px] tracking-[0.11em] text-mute sm:px-8 lg:px-[34px]"
    >
      <a href="/" class="navlink flex items-center gap-[11px] whitespace-nowrap">
        <Mark id="e404" size={15} />
        {site.name.toUpperCase()}
        <span class="hidden text-dim md:inline">· {site.role.toUpperCase()}</span>
      </a>
      <span class="text-mint">404 · ROUTE NOT FOUND</span>
    </header>

    <main
      class="grid flex-1 items-center gap-14 px-5 pt-20 pb-15 sm:px-8 lg:grid-cols-[1fr_400px] lg:px-11"
    >
      <div>
        <div class="line">
          <div data-line class="eyebrow block">
            DIAGNOSTIC &nbsp;·&nbsp; THE NODE YOU ASKED FOR IS NOT IN THIS SYSTEM
          </div>
        </div>

        <h1
          class="mt-[26px] text-[clamp(52px,8vw,116px)] leading-[0.9] font-medium tracking-[-0.05em]"
        >
          <span class="line"><span data-line class="block">This page</span></span>
          <span class="line"
            ><span data-line class="block">was never <span class="text-mint">built</span>.</span
            ></span
          >
        </h1>

        <p data-fade class="mt-8 max-w-[520px] text-[18.5px] leading-[1.6] text-mute opacity-0">
          Either it moved, or the link was wrong, or it only ever existed in someone's notes.
          Nothing is broken. The route simply resolves to nothing.
        </p>

        <div
          data-fade
          class="mono mt-9 max-w-[520px] border border-line bg-panel px-[18px] py-4 text-[11px] leading-[2] opacity-0"
        >
          <div>
            <span class="inline-block w-[92px] text-dim">REQUESTED</span><span
              id="req"
              class="text-paper">/</span
            >
          </div>
          <div>
            <span class="inline-block w-[92px] text-dim">RESOLVED</span><span class="text-mint"
              >no matching route</span
            >
          </div>
          <div>
            <span class="inline-block w-[92px] text-dim">STATUS</span>404 · everything else is fine
          </div>
        </div>

        <div data-fade class="mt-[34px] flex flex-wrap gap-3 opacity-0">
          <a href="/" class="btn">BACK TO THE WORKSHOP →</a>
          <a href="/work" class="btn-ghost">SEE THE WORK</a>
        </div>
      </div>

      <div data-fade class="border border-line bg-panel px-[22px] py-6 opacity-0">
        <div class="mono mb-5 flex justify-between text-[9.5px] tracking-[0.12em] text-dim">
          <span>FIG. 404 / SYSTEM MAP</span>
          <span class="text-mint">{routes.length} OF {routes.length + 1} RESOLVED</span>
        </div>

        <div class="mono flex flex-col text-[10.5px] tracking-[0.07em]">
          {
            routes.map((r, i) => (
              <>
                <a
                  href={r.href}
                  class="flex justify-between border border-mint/45 px-3.5 py-3 text-paper transition-colors hover:bg-mint/10 hover:text-mint"
                >
                  {r.label.toUpperCase()} <span class="text-mint">OK</span>
                </a>
                <div class="relative ml-[22px] h-[26px] w-px overflow-hidden bg-mint/30">
                  {i === 0 && (
                    <span class="absolute top-0 left-0 h-3 w-px animate-[pkt_1.8s_linear_infinite] bg-mint" />
                  )}
                </div>
              </>
            ))
          }
          <div
            class="flex animate-[flick_2.6s_ease-in-out_infinite] justify-between border border-dashed border-edge px-3.5 py-3 text-dim"
          >
            THIS ROUTE <span>MISSING</span>
          </div>
        </div>

        <div class="mono mt-5 border-t border-line pt-4 text-[10px] leading-[1.8] text-mute">
          <div>THINK SOMETHING SHOULD BE HERE?</div>
          <a href={`mailto:${site.email}`} class="tracking-[0.06em] text-mint">{site.email} →</a>
        </div>
      </div>
    </main>

    <footer
      class="mono flex flex-wrap justify-between gap-3.5 border-t border-line px-5 py-[22px] text-[10px] text-dim sm:px-8 lg:px-11"
    >
      <span>© {year} {site.name.toUpperCase()}</span>
      <span>{site.location.toUpperCase()} · {site.timezone}</span>
      <a href="/" class="navlink">HOME</a>
    </footer>
  </div>
</Base>

<script>
  import { lines, reduced, settle } from "../scripts/reveal";
  import "../scripts/transition";
  import { mountCursor } from "../scripts/cursor";
  import { gsap } from "../scripts/reveal";

  // Echo back what was actually asked for. Server-rendered it would always be
  // the same string, because this one file answers every unmatched URL.
  const req = document.getElementById("req");
  if (req) req.textContent = location.pathname + location.search;

  try {
    mountCursor();
    if (reduced) {
      settle();
    } else {
      lines();
      gsap
        .timeline({ defaults: { ease: "expo.out" } })
        .to("[data-fade]", { opacity: 1, duration: 0.8, stagger: 0.11 }, 0.4)
        .fromTo("[data-fade]", { y: 16 }, { y: 0, duration: 0.8, stagger: 0.11 }, 0.4);
    }
  } catch (err) {
    console.error(err);
    settle();
  }
</script>
