---
import About from "../components/About.astro";
import Boot from "../components/Boot.astro";
import Contact from "../components/Contact.astro";
import Hero from "../components/Hero.astro";
import Rail from "../components/Rail.astro";
import Services from "../components/Services.astro";
import Systems from "../components/Systems.astro";
import Topbar from "../components/Topbar.astro";
import Work from "../components/Work.astro";
import { site } from "../data/site";
import Base from "../layouts/Base.astro";
---

<Base
  title={`${site.name} · ${site.role}`}
  description="Product engineer building SaaS, internal tools and product websites end to end. Interface, API, schema, architecture and deploys, built by the person you talk to. Senior engineering without agency overhead."
  ogType="profile"
>
  <Boot />

  {/* three.js spine, faded in after the intro and driven by scroll */}
  <div id="spine" class="pointer-events-none fixed inset-0 z-0 opacity-0"></div>

  <Rail />
  <Topbar />

  <main class="shell lg:ml-[74px]">
    <Hero />
    <Work />
    <Systems />
    <Services />
    <About />
    <Contact />
  </main>
</Base>

<script>
  import "../scripts/motion";
</script>
