---
import About from "../components/About.astro";
import Contact from "../components/Contact.astro";
import Curtain from "../components/Curtain.astro";
import Drawer from "../components/Drawer.astro";
import Footer from "../components/Footer.astro";
import Github from "../components/Github.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Marquee from "../components/Marquee.astro";
import Preloader from "../components/Preloader.astro";
import Pricing from "../components/Pricing.astro";
import Process from "../components/Process.astro";
import Services from "../components/Services.astro";
import Stack from "../components/Stack.astro";
import Timeline from "../components/Timeline.astro";
import Work from "../components/Work.astro";
import { site } from "../data/site";
import Base from "../layouts/Base.astro";
---

<Base
  title={`${site.name} · Full-stack engineer`}
  description="TypeScript engineer: Next.js, NestJS, Postgres. Five years in production, three where the ledger had to balance. SaaS, dashboards and internal tools, built end to end by one person."
>
  <Preloader />

  <div class="fixed top-0 left-0 z-[150] h-0.5 w-full">
    <div id="prog" class="h-full w-full origin-left scale-x-0 bg-accent"></div>
  </div>

  <Header />
  <Drawer />

  <main>
    <Hero />
    <Services />
    <Work />
    <Marquee />
    <Curtain />
    <Process />
    <Stack />
    <About />
    <Timeline />
    <Pricing />
    <Github />
    <Contact />
  </main>

  <Footer />
</Base>

<script>
  import "../scripts/motion";
</script>
