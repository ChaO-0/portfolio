---
import { site } from "../data/site";

const handle = site.github.split("/").pop()!;

// Build-time read of the public contributions calendar. No token needed, but the
// markup is unofficial: if the fetch or the shape fails we render nothing rather
// than inventing activity.
type Day = { date: string; level: number };
let weeks: (Day | null)[][] = [];

try {
  const res = await fetch(`https://github.com/users/${handle}/contributions`, {
    headers: { "user-agent": "astro-build" },
  });
  if (res.ok) {
    const html = await res.text();
    const days = (html.match(/<td[^>]*data-date="[^"]*"[^>]*>/g) ?? [])
      .map((td) => {
        const date = /data-date="([^"]+)"/.exec(td)?.[1];
        const level = /data-level="(\d+)"/.exec(td)?.[1];
        return date && level !== undefined ? { date, level: +level } : null;
      })
      .filter((d): d is Day => d !== null)
      .sort((a, b) => a.date.localeCompare(b.date));

    // one column per calendar week, each day slotted by its weekday
    for (const day of days) {
      const dow = new Date(`${day.date}T00:00:00Z`).getUTCDay();
      if (!weeks.length || dow === 0) weeks.push(Array(7).fill(null));
      weeks[weeks.length - 1][dow] = day;
    }
  }
} catch (err) {
  // The section omits itself below, which is the right visual outcome — but a
  // silent omission is how you discover months later that it broke. Say so.
  console.warn("[github] contributions fetch failed; omitting the section.", err);
}

// level 0 is the empty state; 1–4 ramp the accent
const fills = [
  "rgba(233,237,245,.07)",
  "oklch(.78 .13 220/.25)",
  "oklch(.78 .13 220/.45)",
  "oklch(.78 .13 220/.7)",
  "oklch(.78 .13 220)",
];

const total = weeks.flat().filter((d) => d && d.level > 0).length;
---

{
  weeks.length > 0 && (
    <section class="lattice relative z-[2] bg-ink px-[5vw] pb-[120px]">
      <div class="mx-auto max-w-[1500px] border border-paper/10 px-[34px] pt-9 pb-10">
        <div data-rv class="mb-[30px] flex flex-wrap items-baseline justify-between gap-3">
          <div class="flex items-baseline gap-3.5">
            <span class="font-display text-[19px]/none font-medium tracking-[-.02em]">
              {site.githubHandle}
            </span>
            <span class="font-mono text-[11px]/none text-accent">● LIVE</span>
          </div>
          <a
            href={site.github}
            target="_blank"
            rel="noopener"
            class="link font-mono text-xs/none"
          >
            VIEW PROFILE ↗
          </a>
        </div>

        <div id="gh" data-rv aria-hidden="true" class="flex gap-[3px] overflow-hidden">
          {weeks.map((week) => (
            <div class="flex flex-1 flex-col gap-[3px]">
              {week.map((day) => (
                <div
                  class="gc aspect-square min-h-[9px] flex-1"
                  style={`background:${fills[day ? Math.min(4, day.level) : 0]}`}
                  title={day ? `${day.date} · level ${day.level}` : undefined}
                />
              ))}
            </div>
          ))}
        </div>

        <div
          data-rv
          class="mt-[18px] flex items-center justify-between font-mono text-[11px]/none text-paper/32"
        >
          <span>{total} ACTIVE DAYS, LAST 12 MONTHS</span>
          <span class="flex items-center gap-[7px]">
            LESS
            {fills.map((f) => (
              <span class="size-[11px]" style={`background:${f}`} />
            ))}
            MORE
          </span>
        </div>
      </div>
    </section>
  )
}
