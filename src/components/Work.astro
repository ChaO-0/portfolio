---
import { Image } from "astro:assets";
import { sectionNo, projects } from "../data/site";

// A teaser, not the portfolio. One line per product with a thumbnail, and the
// detail lives on /work and the case studies.
---

<section id="work" class="section">
  <div class="eyebrow mb-[30px]">§ {sectionNo("work")}&nbsp;&nbsp;SELECTED WORK</div>

  <div class="mb-[42px] grid items-end gap-14 lg:grid-cols-[1fr_330px]">
    <h2
      data-reveal
      class="max-w-[680px] text-[clamp(32px,3.8vw,50px)] leading-[1.03] font-medium tracking-[-0.03em]"
    >
      Three systems, designed and shipped end to end.
    </h2>
    <div class="border-l border-line pl-[18px]">
      <p data-reveal class="text-[14.5px] leading-[1.6] text-mute">
        All three are my own products. There are no client logos yet, so the portfolio is the code,
        the decisions and the trade-offs behind each one.
      </p>
      <a data-reveal href="/work" class="navlink mono mt-4 inline-block text-[10.5px] text-mint"
        >ALL THREE, IN DETAIL →</a
      >
    </div>
  </div>

  {
    projects.map((p, i) => (
      <a
        data-reveal
        href={p.index}
        class:list={[
          "row grid items-center gap-5 border-t border-line py-6 lg:grid-cols-[52px_minmax(0,1fr)_minmax(0,1.15fr)_158px_88px]",
          i === projects.length - 1 && "border-b",
        ]}
      >
        <span class="mono text-[11px] text-mint">{String(i + 1).padStart(2, "0")}</span>
        <span class="text-[34px] font-medium tracking-[-0.03em]">{p.title}</span>
        <span class="text-[15px] leading-[1.5] text-mute">{p.teaser}</span>
        <span class="block h-14 overflow-hidden border border-line bg-panel">
          <Image
            src={p.shot}
            alt={p.title}
            widths={[160, 320]}
            sizes="158px"
            class="block h-full w-full object-cover object-left-top"
          />
        </span>
        <span class="mono text-[10px] text-dim lg:text-right">INSPECT →</span>
      </a>
    ))
  }
</section>
