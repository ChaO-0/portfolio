---
import { marquee } from "../data/site";
---

<div class="lattice relative z-[2] overflow-hidden border-y border-paper/8 bg-paper/2 py-5">
  {/* content is doubled so translateX(-50%) loops seamlessly */}
  <div
    class="flex w-max animate-[marquee_34s_linear_infinite] font-mono text-[15px]/none text-paper/45"
    aria-hidden="true"
  >
    {
      [0, 1].map(() =>
        marquee.map((t) => (
          <>
            <span class="pr-[30px]">{t}</span>
            <span class="pr-[30px] text-accent/75">/</span>
          </>
        ))
      )
    }
  </div>
</div>
