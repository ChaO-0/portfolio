---
import { sectionNo, agency, rescue, services } from "../data/site";

// Names only. Descriptions and prices are on /services, one click away in the nav.
const entries = [
  ...services.map((s) => ({ label: s.title, href: `/services#${s.id}` })),
  { label: rescue.title, href: `/services#${rescue.id}` },
  { label: "Engineering capacity", href: "/for-agencies", tag: "AGENCIES" },
];
---

<section id="services" class="section">
  <div class="eyebrow mb-[30px]">§ {sectionNo("services")}&nbsp;&nbsp;SERVICES</div>

  <div class="mb-11 grid items-end gap-15 lg:grid-cols-[1fr_340px]">
    <h2
      data-reveal
      class="max-w-[640px] text-[clamp(32px,3.8vw,50px)] leading-[1.04] font-medium tracking-[-0.03em]"
    >
      What I can build for you.
    </h2>
    <div class="border-l border-line pl-[18px]">
      <p data-reveal class="text-[14.5px] leading-[1.6] text-mute">
        Senior engineering, whole system, without the overhead of an agency. If a project needs
        more hands than it should, I will say so.
      </p>
      <a data-reveal href="/services" class="navlink mono mt-4 inline-block text-[10.5px] text-mint"
        >EVERY SERVICE IN DETAIL →</a
      >
    </div>
  </div>

  <div class="hairgrid sm:grid-cols-2">
    {
      entries.map((e, i) => (
        <a
          data-reveal
          href={e.href}
          class:list={[
            "card flex items-baseline gap-4 px-[22px] py-[19px]",
            i === entries.length - 1 && "sm:col-span-full",
          ]}
        >
          <span class="mono text-[10px] text-mint">
            {e.tag ?? String(i + 1).padStart(2, "0")}
          </span>
          <span class="text-[21px] tracking-[-0.02em]">{e.label}</span>
        </a>
      ))
    }
  </div>
</section>
