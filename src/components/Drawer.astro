---
import { nav, site } from "../data/site";

const links = [
  ...nav.map((item) => ({ ...item, external: false })),
  { label: site.ctaShort, href: site.calendly, external: true },
];
---

{/* inert by default: with no JS the closed overlay must stay out of the tab order */}
<div id="drawer" inert>
  {
    links.map((link, i) => (
      <a
        href={link.href}
        target={link.external ? "_blank" : undefined}
        rel={link.external ? "noopener" : undefined}
        style={`--i:${i}`}
        class:list={["dl", i === links.length - 1 && "text-accent"]}
      >
        {link.label}
      </a>
    ))
  }

  <div class="mt-[30px] font-mono text-[11.5px]/[1.7] text-paper/35">
    {site.location.split(",")[0].toUpperCase()} · {site.timezone}<br />{site.githubHandle}
  </div>
</div>
