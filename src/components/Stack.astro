---
import { stack } from "../data/site";
---

<section class="lattice relative z-[2] bg-ink px-[5vw] pb-[120px]">
  <div class="mx-auto max-w-[1500px] hair-grid [grid-template-columns:repeat(auto-fit,minmax(180px,1fr))]">
    {
      stack.map((group) => (
        <dl data-rv data-rv-fade class="stack-cell m-0 flex flex-col gap-[9px] px-6 py-7">
          {/* mb + the flex gap add up to the 18px gutter under the label */}
          <dt
            class:list={[
              "mb-[9px] font-mono text-[11px]/none",
              group.accent ? "text-accent" : "text-paper/35",
            ]}
          >
            {group.label}
          </dt>
          {group.items.map((item, i) => (
            <dd class="m-0 text-[14.5px]/none text-paper/75" style={`--i:${i}`}>
              {item}
            </dd>
          ))}
        </dl>
      ))
    }
  </div>
</section>
