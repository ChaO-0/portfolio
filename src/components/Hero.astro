---
import { sectionNo } from "../data/site";
// The right panel is FIG.01: the same spine every project on this site is built
// on, drawn once so the claim in the Systems section is visible before it's made.
---

<section
  id="hero"
  class="grid min-h-screen grid-cols-1 border-b border-line lg:grid-cols-[1fr_380px]"
>
  <div
    class="flex flex-col justify-center px-5 pt-[124px] pb-16 sm:px-8 lg:pt-[150px] lg:pr-11 lg:pl-10"
  >
    <div data-hero-fade class="eyebrow mb-[34px] opacity-0">
      § {sectionNo("hero")}&nbsp;&nbsp;THE WORKSHOP IS OPEN &nbsp;·&nbsp; BALI, UTC+8
    </div>

    <h1
      class="max-w-[860px] text-[clamp(46px,6.4vw,88px)] leading-[0.98] font-medium tracking-[-0.04em]"
    >
      <span class="line"><span data-line class="block">I build products</span></span>
      <span class="line"
        ><span data-line class="block">from <span class="text-mute">idea</span> to</span></span
      >
      <span class="line"
        ><span data-line class="block"><span class="text-mint">production</span>.</span></span
      >
    </h1>

    <p
      data-hero-fade
      class="mt-9 max-w-[540px] text-[18.5px] leading-[1.58] text-mute opacity-0 text-pretty"
    >
      A product engineer working with founders and teams who want one person to own the whole
      thing. Interface, API, schema, architecture, deploys. You work directly with the
      person writing the code, not an account manager, and you get senior engineering without the
      overhead of an agency.
    </p>

    <div data-hero-fade class="mt-10 flex flex-wrap gap-2.5 opacity-0">
      <a href="#contact" class="btn">START A PROJECT →</a>
      <a href="#work" class="btn-ghost">SEE THE WORK →</a>
    </div>
  </div>

  <div
    data-hero-panel
    class="flex flex-col border-t border-line bg-gradient-to-b from-mint/[0.07] to-mint/[0.015] px-[22px] pt-16 pb-[26px] opacity-0 lg:border-t-0 lg:border-l lg:pt-24"
  >
    <div class="mono mb-[18px] flex justify-between text-[9.5px] tracking-[0.12em] text-mint">
      <span>FIG.01 / SHAPE OF EVERY PROJECT</span><span>● LIVE</span>
    </div>

    <div class="mono flex flex-col text-[10px] tracking-[0.07em]">
      <div class="flex justify-between border border-mint bg-mint/[0.12] px-3.5 py-3 text-mint">
        <span>CLIENT</span><span>next.js</span>
      </div>

      <div class="relative ml-[22px] h-8 w-px overflow-hidden bg-mint/30">
        <span class="absolute top-0 left-0 h-4 w-px animate-[pkt_1.8s_linear_infinite] bg-mint"
        ></span>
      </div>

      <div class="flex justify-between border border-mint/40 px-3.5 py-3">
        <span>API</span><span class="text-mint">node</span>
      </div>

      <div class="relative ml-[22px] h-8 w-px overflow-hidden bg-mint/30">
        <span
          class="absolute top-0 left-0 h-4 w-px animate-[pkt_1.8s_linear_0.4s_infinite] bg-mint"
        ></span>
      </div>

      <div class="flex gap-2">
        <div class="flex-1 border border-mint/40 px-3.5 py-3">POSTGRES</div>
        <div class="flex-1 border border-line px-3.5 py-3 text-mute">REDIS</div>
      </div>

      <div class="relative ml-[22px] h-8 w-px overflow-hidden bg-mint/30">
        <span
          class="absolute top-0 left-0 h-4 w-px animate-[pkt_1.8s_linear_0.8s_infinite] bg-mint"
        ></span>
      </div>

      <div class="flex justify-between border border-mint/40 px-3.5 py-3">
        <span>WORKERS</span><span class="text-mint">queue</span>
      </div>
    </div>

    <div class="mono mt-auto border-t border-mint/25 pt-[22px] text-[9.5px] leading-[1.95] text-mint">
      <div>SPINE FOLLOWS THE SCROLL</div>
      <div class="text-mute">CURSOR SHIFTS THE VIEW</div>
    </div>
  </div>
</section>
