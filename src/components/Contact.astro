---
import { sectionNo, site } from "../data/site";

const year = new Date().getFullYear();
---

<section
  id="contact"
  class="px-5 pt-24 pb-15 sm:px-8 lg:pr-11 lg:pl-10"
>
  <div class="eyebrow mb-[34px]">§ {sectionNo("contact")}&nbsp;&nbsp;START A PROJECT</div>

  <h2
    data-reveal
    class="max-w-[900px] text-[clamp(40px,6vw,84px)] leading-[0.98] font-medium tracking-[-0.04em]"
  >
    Tell me what you are building.
  </h2>

  <p data-reveal class="mt-8 max-w-[560px] text-[18.5px] leading-[1.6] text-mute">
    What it is, roughly when you need it, and what is already built. I will reply with an honest
    read on scope, and whether this is the right fit.
  </p>

  <div data-reveal class="mt-11 flex flex-wrap items-stretch gap-3">
    <a href={`mailto:${site.email}`} class="btn gap-3.5 px-7 py-[22px] text-[13px] tracking-[0.06em]">
      {site.email} <span>→</span>
    </a>
    <a
      href={site.calendly}
      target="_blank"
      rel="noopener"
      class="btn-ghost gap-3.5 px-7 py-[22px] text-[13px] tracking-[0.06em]"
    >
      BOOK 30 MINUTES <span>→</span>
    </a>
  </div>

  <footer
    class="mono mt-[90px] flex flex-wrap justify-between gap-3.5 border-t border-line pt-[22px] text-[10px] text-dim"
  >
    <span>© {year} {site.name.toUpperCase()}</span>
    <span>{site.location.toUpperCase()} · {site.timezone}</span>
    {/* These three were declared in the Person schema's sameAs and rendered
        nowhere, so the profiles backing the claim were unreachable from the site. */}
    <span class="flex gap-5">
      {
        [
          ["GITHUB", site.github],
          ["X", site.x],
          ["LINKEDIN", site.linkedin],
        ].map(([label, href]) => (
          <a href={href} target="_blank" rel="noopener me" class="navlink">
            {label}
          </a>
        ))
      }
    </span>
  </footer>
</section>
