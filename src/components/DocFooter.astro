---
import { nav, site } from "../data/site";

// The bar stays minimal, so this is the only way off a sub-page and onto a
// sibling one. It carries the whole nav rather than an ad-hoc link or two.
const year = new Date().getFullYear();
---

<footer
  class="mono flex flex-wrap items-center justify-between gap-x-6 gap-y-3.5 border-t border-line px-5 py-[22px] text-[10px] text-dim sm:px-8 lg:px-11"
>
  <span>© {year} {site.name.toUpperCase()}</span>
  <nav class="flex flex-wrap gap-x-6 gap-y-2">
    <a href="/" class="navlink">HOME</a>
    {
      nav.map((item) => (
        <a href={item.href} class="navlink">
          {item.label.toUpperCase()}
        </a>
      ))
    }
  </nav>
</footer>
