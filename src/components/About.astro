---
import { Image } from "astro:assets";
import { portraitShot, sectionNo, site } from "../data/site";

// A teaser, like Work and Services. The background, the stack and the facts grid
// live on /about; this is the one paragraph that earns the click.
---

<section id="about" class="section">
  <div class="eyebrow mb-[30px]">§ {sectionNo("about")}&nbsp;&nbsp;ABOUT</div>

  <div class="grid items-center gap-14 lg:grid-cols-[300px_minmax(0,640px)]">
    <div data-parallax="-20">
      <div data-mask class="frame overflow-hidden p-0">
        <Image
          src={portraitShot}
          alt={site.name}
          widths={[300, 600]}
          sizes="(min-width: 1024px) 300px, 92vw"
          class="h-[320px] contrast-[1.03] grayscale-[0.35]"
        />
      </div>
      <div class="figcap">
        <span>C. YU / BALI</span><span>FIG. {sectionNo("about")}.1</span>
      </div>
    </div>

    <div>
      <h2
        data-reveal
        class="text-[clamp(30px,3.4vw,44px)] leading-[1.06] font-medium tracking-[-0.03em]"
      >
        The engineer behind the systems.
      </h2>
      <p data-reveal class="mt-6.5 text-lg leading-[1.6] text-mute">
        Five years shipping production software: a year at a blockchain company where mistakes are
        public and expensive, three at a fintech where the ledger has to balance every time, and a
        year at an agency where the deadline is the deadline. I work remotely from Bali, UTC+8.
      </p>
      <a data-reveal href="/about" class="navlink mono mt-6 inline-block text-[10.5px] text-mint"
        >MORE ABOUT ME →</a
      >
    </div>
  </div>
</section>
