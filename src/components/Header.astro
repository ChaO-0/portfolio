---
import { nav, site } from "../data/site";
import Button from "./Button.astro";
import Flip from "./Flip.astro";
---

<header
  class="fixed inset-x-0 top-0 z-[120] flex items-center justify-between border-b border-paper/7 bg-ink/70 px-[5vw] py-[18px] backdrop-blur-[14px]"
>
  <a href="#top" aria-label={site.name} class="flex items-center gap-2.5">
    {/* The mark: a ring with an aperture cut out of the right side and an inner
        counter, which reads as a C. fill="currentColor" so the colour comes from
        the text-accent class rather than being baked into the path. */}
    <svg class="block size-6 shrink-0 text-accent" viewBox="0 0 48 48" aria-hidden="true">
      <mask id="cyMark">
        <rect width="48" height="48" fill="#fff"></rect>
        <circle cx="24" cy="24" r="9" fill="#000"></circle>
        <rect x="24" y="19" width="24" height="10" fill="#000"></rect>
      </mask>
      <circle cx="24" cy="24" r="21" fill="currentColor" mask="url(#cyMark)"></circle>
    </svg>
    <span class="text-[14.5px]/none font-medium">{site.name}</span>
  </a>

  <nav class="flex items-center gap-[26px] font-mono text-[12.5px]/none">
    <span id="navLinks" class="flex items-center gap-[26px]">
      {
        nav.map((item) => (
          <a href={item.href} aria-label={item.label} class="hx text-paper/55">
            <Flip text={item.label.toUpperCase()} />
            <span class="hx-rule" />
          </a>
        ))
      }
    </span>

    <Button
      href={site.calendly}
      label={site.ctaShort}
      target="_blank"
      class="px-[18px] py-[11px] text-[12.5px]"
    />

    <button id="burger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="drawer">
      <span></span><span></span>
    </button>
  </nav>
</header>
