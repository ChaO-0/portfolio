---
import { steps } from "../data/site";

// The five steps only, no section chrome. Lived on the home page until the home
// page became teasers; now it sits under How it works on /services.
---

{
  steps.map((s, i) => (
    <div
      data-reveal
      class:list={[
        "grid items-start gap-6.5 border-t border-line py-6.5 md:grid-cols-[80px_1fr_1fr]",
        i === steps.length - 1 && "border-b",
      ]}
    >
      <span class="mono text-[11px] text-mint">{String(i + 1).padStart(2, "0")}</span>

      <div>
        <div class="mb-2 text-[26px] tracking-[-0.02em]">{s.title}</div>
        <div class="max-w-[420px] text-base leading-[1.55] text-mute">{s.body}</div>
      </div>

      {/* One label, three lines: the label owns row 1 of the left column and the
          deliverables auto-flow down the right one. */}
      <dl class="mono grid grid-cols-[68px_1fr] text-[11px] leading-[2] text-mute">
        <dt class="col-start-1 row-start-1 text-dim">YOU GET</dt>
        {s.gets.map((g) => (
          <dd class="col-start-2 m-0">{g}</dd>
        ))}
      </dl>
    </div>
  ))
}
