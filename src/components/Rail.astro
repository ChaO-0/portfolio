---
import { sections } from "../data/site";

const last = sections.length - 1;
const total = String(sections.length).padStart(2, "0");
---

<nav
  aria-label="Sections"
  class="fixed inset-y-0 left-0 z-30 hidden w-[74px] flex-col items-center border-r border-line bg-well pt-[18px] pb-6 lg:flex"
>
  <a href="#hero" class="mono mb-6 text-[10px] tracking-[0.22em] text-mint [writing-mode:vertical-rl]"
    >C.YU</a
  >

  <div class="flex w-full flex-1 flex-col items-center">
    {
      sections.map((s, i) => (
        <a
          href={`#${s.id}`}
          data-rail
          {...(i === 0 && { "data-on": "" })}
          aria-label={s.label}
          class:list={["group flex w-full flex-col items-center", i < last && "flex-1"]}
        >
          <span class="size-[7px] flex-none rounded-full border border-edge transition-all duration-300 group-data-on:size-[9px] group-data-on:border-mint group-data-on:bg-mint group-data-on:shadow-[0_0_0_5px_rgba(87,200,165,0.14)]" />
          {i < last && <span class="w-px flex-1 bg-line" />}
        </a>
      ))
    }
  </div>

  <span
    id="rail-count"
    class="mono mt-5 text-[9px] tracking-[0.16em] text-dim [writing-mode:vertical-rl]"
    >01 / {total}</span
  >
</nav>
