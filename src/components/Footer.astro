---
import { site } from "../data/site";
---

<footer
  class="lattice relative z-[2] flex flex-wrap items-center justify-between gap-5 border-t border-paper/8 bg-ink px-[5vw] py-[34px] font-mono text-[11.5px]/none text-paper/32"
>
  <span>{site.name.toUpperCase()} · {site.role.toUpperCase()}</span>
  <span>{site.location.toUpperCase()} · {site.timezone}</span>
  <span>© {new Date().getFullYear()}</span>
</footer>
